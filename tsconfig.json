{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@server/*": ["./server/*"],
      "@client/*": ["./client/src/*"]
    },
    "outDir": "./dist",
    "noEmit": true
  },
  "include": ["client/src/**/*", "server/**/*", "drizzle/**/*"],
  "exclude": ["node_modules", "dist"]
}
